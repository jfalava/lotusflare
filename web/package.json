{
  "name": "@lotusflare/web",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings ./cloudflare-env.d.ts",
    "check": "bun typecheck && bun lint",
    "deploy": "bun run cf-typegen && bun run typecheck && bun run lint && bun run format && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:fast": "bun run typecheck && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev --turbopack",
    "format": "oxfmt",
    "lint": "oxlint . --type-aware --fix",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsgo --noEmit"
  },
